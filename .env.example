# Never commit the real .env
MODE=auto                  # auto | mock | live | gemini_only | groq_only
GEMINI_API_KEY=            # free key from aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=     # optional second Gemini model; see scripts/list_models.py
GEMINI_GROUNDING=on        # web search for research; set off if it hits free-tier limits
GEMINI_MIN_INTERVAL=8
GROQ_API_KEY=              # Groq API key; this is Groq, not xAI
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RESEARCH_MODEL=openai/gpt-oss-120b   # uses built-in browser_search
GROQ_TPM=8000              # configured tokens/minute budget; adjust to your account limit
GROQ_REVISION_TPM=6500      # safer per-request budget for QA revision prompts
PIPELINE_LEAN=on
MAX_REVISIONS=1
PIPELINE_CACHE=on
# With BOTH keys set, a router plans every request (input + output + search overhead against each provider's limits, keeping 25% headroom)
# and picks the provider: Gemini reads/writes/audits, Groq's browser_search does web research unless Gemini grounding is confirmed.

GROQ_BROWSER_SEARCH=on      # enable built-in browser_search for research stages
GROQ_REASONING_EFFORT=low   # less hidden thinking = fewer tokens per day on Groq's free tier (empty = off)
SOURCE_CHECK=on             # visit cited URLs; drop made-up URLs and unconfirmed clock times
STRATEGY_PREDICT=ai         # ai = keywords first, one AI call only when the request is ambiguous; always_ai = ask every time; heuristic = never ask
APP_PASSWORD=               # optional. Set this before putting the app on a public URL, otherwise anyone with the link can spend your API quota
CONFIG_PASSWORD=            # optional. Protects the Configuration tab (rules, limits, QA). Set this on any shared or public deployment
CONFIG_DIR=                 # optional. Where configuration versions are stored. Default: data/config

# --- API keys by purpose (optional) -----------------------------------------------------------------------------
# One key per purpose spreads the load. A purpose without its own key uses the shared key above.
# IMPORTANT: Gemini limits are per Google PROJECT and Groq limits per ORGANISATION, not per key. Keys only add capacity
# when they come from DIFFERENT Google projects / different Groq organisations.
# Several keys for one purpose can be separated by commas: when one hits its limit the next is used.
GEMINI_API_KEY_CONTEXT=
GEMINI_API_KEY_RESEARCH=
GEMINI_API_KEY_GENERATION=
GEMINI_API_KEY_QA=
GROQ_API_KEY_CONTEXT=
GROQ_API_KEY_RESEARCH=
GROQ_API_KEY_GENERATION=
GROQ_API_KEY_QA=

# --- Purpose-specific keys (unchanged) ------------------------------------------------------------------------------
# GEMINI_API_KEY_<PURPOSE> / GROQ_API_KEY_<PURPOSE> for CONTEXT, RESEARCH, GENERATION, QA keep working exactly as before (several keys
# per purpose, comma separated; the shared GEMINI_API_KEY / GROQ_API_KEY is the backup). Also recognised:
#   GEMINI_API_KEY_GENERATE / GROQ_API_KEY_GENERATE   older spelling, used ONLY when the _GENERATION variable is empty
#   GEMINI_API_KEY_STRATEGY / GROQ_API_KEY_STRATEGY   used for the strategy-prediction call; without them that call uses the CONTEXT keys
# Per-stage model variables GEMINI_MODEL_RESEARCH / _QA / _GENERATION (or _GENERATE) / _STRATEGY are preserved and shown on the
# Maintenance screen but, as in the deployed application, NOT applied unless Configuration -> "Per-stage Gemini model variables" = apply.

# --- Quota groups: which Google project / Groq organisation each key belongs to -------------------------------------
# Quotas are per Google PROJECT and per Groq ORGANISATION (and model), not per key. Keys not listed here are 'unverified' and are
# assumed to share ONE quota; the system also learns a project / organisation when a provider error names it.
# Use the fingerprints shown in Configuration -> Maintenance -> Quota groups. These two variables are optional; the same can be
# entered in the Configuration tab.
GEMINI_KEY_GROUPS=                  # e.g. 39a3c5=project-a,41b911=project-a,7cee66=project-b
GROQ_KEY_GROUPS=                    # e.g. d5905c=org-main

# --- Request budget and routing (all optional; the defaults are the approved values) --------------------------------
# Limits live in Configuration -> Provider settings (Gemini limits per project and model). Verified and shipped: gemini-3.6-flash on the
# free tier = 5 requests/minute, 250,000 tokens/minute, 20 requests/day. Any other model or project is treated conservatively
# (assumed no better) until you enter its limits.
RULES_SCOPING=all                   # all = each stage gets only its rule sections | groq = only calls to Groq are scoped | off = full documents everywhere
GEMINI_GROUNDING_CAPABILITY=auto    # auto = never assumed: tried once per key/model, then remembered | yes = confirmed for your project | no = never
GEMINI_MODEL_POOL=                  # optional, comma separated: extra Gemini models tried in order when one is limited. Only list models you have confirmed
GEMINI_STAGE_MODELS_ENV=ignore      # ignore (as always) | apply: use the GEMINI_MODEL_<STAGE> variables above
USAGE_LOG=on                        # write a JSON-lines usage log (tokens per call, never prompts or keys) next to the cache; off = in-memory only
